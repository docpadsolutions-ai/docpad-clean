{"nodes": [{"id": "docs_architecture_docpad_architecture", "label": "DocPad Architecture Map", "file_type": "document", "source_file": "docs/architecture/docpad-architecture.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_docpad_architecture_system_architecture", "label": "DocPad system architecture (Next.js 16 on Vercel + one Supabase project)", "file_type": "concept", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The browser does most of the work; client components query Postgres directly via supabase-js. The Next.js server only handles things needing a secret (AI, WhatsApp, SNOMED, FHIR export, backups). No staging, queue, cache tier or warehouse."}, {"id": "docs_architecture_docpad_architecture_rls_security_boundary", "label": "Row Level Security as the real security boundary", "file_type": "rationale", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a71, \u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Because the browser writes to the database directly with the user's JWT, RLS policies (476) rather than app code enforce access; tenant key on every row."}, {"id": "docs_architecture_docpad_architecture_row_level_tenancy", "label": "Single shared schema with row-level tenancy (hospital_id)", "file_type": "rationale", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Caller's hospital resolved auth.uid() -> practitioners.user_id -> practitioners.hospital_id; child tables scoped via parent; global reference tables have no tenant column."}, {"id": "docs_architecture_docpad_architecture_auth_hospital_id", "label": "auth_hospital_id()", "file_type": "concept", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_docpad_architecture_proxy_ts", "label": "proxy.ts role-based route gating", "file_type": "code", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_docpad_architecture_ecg_digitizer_side_service", "label": "ECG digitizer side service (FastAPI, not deployed)", "file_type": "concept", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_docpad_architecture_abdm_gateway", "label": "ABDM gateway HIP/HIU M1-M3 skeleton (ABDM_GATEWAY_URL unset)", "file_type": "concept", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_docpad_architecture_edge_functions", "label": "Supabase edge functions (12, Deno: ABDM, AI, email)", "file_type": "concept", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_docpad_architecture_finalize_prescription_request_path", "label": "Request path: finalizing a prescription", "file_type": "concept", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Safety checks and the record lock live in Postgres triggers, not in the app, so a request that skips the UI still hits them. The WhatsApp API route reads the recipient from the database, not the request body."}, {"id": "docs_architecture_docpad_architecture_check_prescription_safety", "label": "check_prescription_safety RPC", "file_type": "concept", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_docpad_architecture_finalize_prescription", "label": "finalize_prescription RPC", "file_type": "concept", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_docpad_architecture_aa_block_unsafe_prescription", "label": "aa_block_unsafe_prescription trigger", "file_type": "concept", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_docpad_architecture_aa_lock_finalized_encounter", "label": "aa_lock_finalized_encounter trigger", "file_type": "concept", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a72, \u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_docpad_architecture_zz_audit_row", "label": "zz_audit_row trigger / append-only audit_logs", "file_type": "concept", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a72, \u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes old and new JSONB to audit_logs on 83 tables; log_phi_read() records reads inside RPCs."}, {"id": "docs_architecture_docpad_architecture_api_whatsapp", "label": "/api/whatsapp route (Twilio WhatsApp)", "file_type": "concept", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_docpad_architecture_get_public_prescription", "label": "get_public_prescription anon RPC (/rx/[id])", "file_type": "concept", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a71, \u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_docpad_architecture_single_oltp_store", "label": "One OLTP Postgres store, no analytical store", "file_type": "rationale", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All data lands in one Postgres; dashboards call ~30 get_* RPCs on live tables. 'ETL' = one-off reference loaders, trigger chains, AI extraction calls."}, {"id": "docs_architecture_docpad_architecture_billing_trigger_chain", "label": "Billing trigger chain (charges derived, not entered)", "file_type": "rationale", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clinical events create charge_items via triggers (trg_auto_consultation_charge, trg_investigation_to_billing, trg_ipd_treatment_to_billing, trg_auto_bill_consumable) which roll up to invoice_line_items and invoice totals (aa_invoice_line_math, zz_recalc_invoice_from_line/payment)."}, {"id": "docs_architecture_docpad_architecture_mar_nursing_trigger_chain", "label": "MAR / nursing task / MEWS trigger chain", "file_type": "concept", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_docpad_architecture_fhir_shaped_billing", "label": "FHIR-shaped billing model (ChargeItemDefinition -> ChargeItem -> Invoice)", "file_type": "rationale", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a75, \u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unit price is snapshotted onto the charge item at creation so later price changes do not rewrite history."}, {"id": "docs_architecture_docpad_architecture_icd10_library_vector_search", "label": "icd10_library with pgvector embeddings (search_icd10)", "file_type": "concept", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a74, \u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_docpad_architecture_ingest_icd10_script", "label": "scripts/ingest-icd10.ts batch loader", "file_type": "code", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_docpad_architecture_doctor_interaction_embeddings", "label": "doctor_interaction_embeddings / match_interactions similarity search", "file_type": "concept", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_docpad_architecture_google_gemini", "label": "Google Gemini (2.5-flash, embedding-001)", "file_type": "concept", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_docpad_architecture_assemblyai", "label": "AssemblyAI transcription", "file_type": "concept", "source_file": "docs/architecture/docpad-architecture.html", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_docpad_architecture_csiro_ontoserver", "label": "CSIRO Ontoserver SNOMED CT lookup", "file_ty