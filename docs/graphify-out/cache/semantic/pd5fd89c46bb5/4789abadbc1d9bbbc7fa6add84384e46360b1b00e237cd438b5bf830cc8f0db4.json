{"nodes": [{"id": "_github_workflows_db_safety_tests_database_safety_tests_workflow", "label": "Database safety tests workflow", "file_type": "code", "source_file": ".github/workflows/db-safety-tests.yml", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pgTAP suites run inside rolled-back transactions so they are safe against any environment; nightly cron plus push/PR on migrations, tests, PrescriptionModal.tsx and usePrescriptionSafety.ts."}, {"id": "_github_workflows_db_safety_tests_clinical_safety_suite", "label": "Clinical safety suite (clinical_safety.sql)", "file_type": "code", "source_file": ".github/workflows/db-safety-tests.yml", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blocking gate required by Proposal v1.0 s2.1 and SOW s5; asserts finalised encounters are immutable, severe interaction/matching allergy block writes, cross-reactivity advises. Runs first so a broken safety rule tops the log; these rules lived only in the UI until 18 Sep 2026."}, {"id": "_github_workflows_db_safety_tests_billing_arithmetic_suite", "label": "Billing arithmetic suite (billing_arithmetic.sql)", "file_type": "code", "source_file": ".github/workflows/db-safety-tests.yml", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live data proves nothing (every line qty 1, no discount, no tax); first discounted test found balance_due subtracted the discount twice."}, {"id": "_github_workflows_db_safety_tests_rls_isolation_suite", "label": "Tenancy and audit suite (rls_isolation.sql)", "file_type": "code", "source_file": ".github/workflows/db-safety-tests.yml", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asserts cross-hospital isolation, anon reaches only public RPCs, no staff self-promotion, audit trail records edits and chart opens, appointment and DPDPA rules hold."}, {"id": "_github_workflows_db_safety_tests_migration_drift_check", "label": "Migration drift check (check-migration-drift.mjs)", "file_type": "code", "source_file": ".github/workflows/db-safety-tests.yml", "source_location": "L106", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exists because the folder drifted to 173 files (93 never applied) against 375 applied migrations (296 with no file) and nothing failed."}, {"id": "_github_workflows_db_safety_tests_supabase_db_url_secret", "label": "SUPABASE_DB_URL repository secret", "file_type": "concept", "source_file": ".github/workflows/db-safety-tests.yml", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without it every step is skipped and the job passes green, the exact failure mode 'blocking gate' language exists to prevent."}, {"id": "_github_workflows_db_safety_tests_inactive_gate_warning", "label": "Inactive gate warning (silent green pass)", "file_type": "rationale", "source_file": ".github/workflows/db-safety-tests.yml", "source_location": "L110", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A gate that cannot fail is not a gate; warning annotation makes the skipped state visible rather than silent."}], "edges": [{"source": "_github_workflows_db_safety_tests_database_safety_tests_workflow", "target": "_github_workflows_db_safety_tests_clinical_safety_suite", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/db-safety-tests.yml", "source_location": "L70", "weight": 1.0}, {"source": "_github_workflows_db_safety_tests_database_safety_tests_workflow", "target": "_github_workflows_db_safety_tests_billing_arithmetic_suite", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/db-safety-tests.yml", "source_location": "L82", "weight": 1.0}, {"source": "_github_workflows_db_safety_tests_database_safety_tests_workflow", "target": "_github_workflows_db_safety_tests_rls_isolation_suite", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/db-safety-tests.yml", "source_location": "L94", "weight": 1.0}, {"source": "_github_workflows_db_safety_tests_database_safety_tests_workflow", "target": "_github_workflows_db_safety_tests_migration_drift_check", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/db-safety-tests.yml", "source_location": "L106", "weight": 1.0}, {"source": "_github_workflows_db_safety_tests_database_safety_tests_workflow", "target": "_github_workflows_db_safety_tests_supabase_db_url_secret", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/db-safety-tests.yml", "source_location": "L60", "weight": 1.0}, {"source": "_github_workflows_db_safety_tests_inactive_gate_warning", "target": "_github_workflows_db_safety_tests_supabase_db_url_secret", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/db-safety-tests.yml", "source_location": "L29", "weight": 1.0}, {"source": "_github_workflows_db_safety_tests_database_safety_tests_workflow", "target": "_github_workflows_ci_ci_workflow", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": ".github/workflows/db-safety-tests.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_db_safety_tests_clinical_safety_suite", "target": "phase1_plan_finalised_encounter_db_lock", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/db-safety-tests.yml", "source_location": "L6", "weight": 1.0}, {"source": "_github_workflows_db_safety_tests_clinical